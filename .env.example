# VVS-AI-CO 백본 API 키 (조직도 v4)
#
# 사용법:
#   1) 이 파일을 .env 로 복사:  cp .env.example .env
#   2) .env 에 실제 키 값을 입력 (= 우측에 키 붙여넣기)
#   3) .env 는 .gitignore 로 커밋 금지됨. 이 .env.example 만 커밋된다.
#
# 멀티 모델 분리 (작성≠채점 편향 방지):
#   - Claude(Anthropic) : AI PM 총괄 + 작성(L1/L2/L4) + 페르소나
#   - GPT(OpenAI)        : 채점(Scoring Engine, 블라인드·독립) ★
#   - Gemini(Google)     : 시각 디자인 검수

# ── Anthropic (Claude) — AI PM·작성·페르소나 ──
# AI PM 백본 = claude-opus-4-8 (조직도 v4: GPT-5.5 → Opus 4.8 MAX 변경)
ANTHROPIC_API_KEY=

# ── OpenAI (GPT) — 채점 전용 (독립) ──
# Scoring Engine = GPT-5.5 (블라인드 채점). 작성 계열(Claude)과 분리.
OPENAI_API_KEY=

# ── Google (Gemini) — 시각 디자인 검수 ──
# Design Vision = Gemini 3.1 Pro
GEMINI_API_KEY=

# ── 모델 ID (조직도 v4 백본 매핑; 코드가 이 값을 읽는다) ──
AIPM_MODEL=claude-opus-4-8
WRITER_CORE_MODEL=claude-opus-4-8
WRITER_DEFAULT_MODEL=claude-sonnet-4-6
WRITER_L4_MODEL=claude-haiku-4-5
PERSONA_MODEL=claude-sonnet-4-6
SCORING_MODEL=gpt-5.5
DESIGN_MODEL=gemini-3.1-pro
